rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Privileged authorization uses the same source as Storage rules:
    // verified Firebase Auth custom claims, with the designated owner email
    // retained as the bootstrap owner identity.
    function hasRole(role) {
      return isSignedIn()
        && ('role' in request.auth.token)
        && request.auth.token.role == role;
    }

    function isModerator() {
      return isSignedIn() && (
        hasRole('moderator') || hasRole('admin') || hasRole('owner') ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        hasRole('admin') || hasRole('owner') ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com')
      );
    }

    function isSystemOwner() {
      return isSignedIn() && (
        hasRole('owner') ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com')
      );
    }

    // Any authenticated account may submit, but only the fixed pending_review
    // state can be originated by a contributor. Role escalation is never
    // accepted from a submission document.
    function isContributor() {
      return isSignedIn();
    }

    function getExperimentDoc(expId) {
      return get(/databases/$(database)/documents/experiments/$(expId)).data;
    }

    function experimentExists(expId) {
      return exists(/databases/$(database)/documents/experiments/$(expId));
    }

    function isValidMeasurementPayload(expId, measurements) {
      return measurements is map
        && experimentExists(expId)
        && getExperimentDoc(expId).measurementSchema is list
        && getExperimentDoc(expId).allowedMeasurementKeys is list
        && measurements.keys().hasOnly(getExperimentDoc(expId).allowedMeasurementKeys)
        && measurements.keys().size() > 0;
    }

    function submissionIdentityMatches(data) {
      return ('authorId' in data)
        && data.authorId == request.auth.uid
        && (!('userId' in data) || data.userId == request.auth.uid);
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
                    && request.resource.data.uid == userId
                    && (
                      request.resource.data.role == 'contributor' ||
                      (request.resource.data.role == 'owner' && isSystemOwner())
                    )
                    && (!('reputationScore' in request.resource.data)
                        || request.resource.data.reputationScore == 0
                        || isSystemOwner());

      allow update: if (
                      isOwner(userId)
                      && request.resource.data.role == resource.data.role
                      && (!('reputationScore' in request.resource.data)
                          || request.resource.data.reputationScore == resource.data.reputationScore)
                      && request.resource.data.uid == userId
                    ) || isAdmin();

      allow delete: if isAdmin();
    }

    // 2. Hardware Devices Catalog
    match /devices/{deviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasAll(['id', 'brand', 'model', 'category', 'origin', 'status'])
                            && request.resource.data.id == deviceId
                            && request.resource.data.brand is string
                            && request.resource.data.model is string
                            && request.resource.data.category in ['smartphone', 'laptop', 'wearable', 'tablet', 'accessory']
                            && request.resource.data.origin in ['official_wdiii', 'community']
                            && request.resource.data.status in ['active', 'archived', 'deprecated', 'draft', 'private'];
      allow delete: if isAdmin();
    }

    // 3. Official Experiment Protocols
    match /experiments/{experimentId} {
      allow read: if true;
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasAll(['id', 'title', 'category', 'status', 'origin'])
                            && request.resource.data.id == experimentId
                            && request.resource.data.title is string
                            && request.resource.data.category in ['repair', 'support', 'software', 'legal', 'hardware', 'ecosystem', 'ai']
                            && request.resource.data.origin in ['official_wdiii', 'community']
                            && request.resource.data.status in ['done', 'progress', 'pending', 'paused', 'queued', 'draft', 'private']
                            && (!('measurementSchema' in request.resource.data) || request.resource.data.measurementSchema is list)
                            && (!('allowedMeasurementKeys' in request.resource.data) || request.resource.data.allowedMeasurementKeys is list);
      allow delete: if isAdmin();
    }

    // 4. Community submissions
    match /submissions/{submissionId} {
      allow read: if resource.data.status == 'approved'
                  || (isSignedIn() && (
                    (('userId' in resource.data) && resource.data.userId == request.auth.uid) ||
                    (('authorId' in resource.data) && resource.data.authorId == request.auth.uid) ||
                    isModerator()
                  ));

      // Contributors can only create a complete, pending-review replication.
      // hasOnly prevents client-supplied reviewer fields and private email data.
      allow create: if isContributor()
                    && request.resource.data.keys().hasOnly([
                      'id', 'authorId', 'authorDisplayName', 'userId', 'submitterName',
                      'deviceId', 'experimentId', 'type', 'status', 'measurements',
                      'conditions', 'notes', 'evidence', 'evidenceReferences',
                      'createdAt', 'updatedAt', 'submittedAt', 'review', 'reviewerId',
                      'reviewedAt', 'reviewNotes', 'provenance'
                    ])
                    && request.resource.data.id == submissionId
                    && submissionIdentityMatches(request.resource.data)
                    && request.resource.data.status == 'pending_review'
                    && request.resource.data.type == 'replication'
                    && request.resource.data.deviceId is string
                    && request.resource.data.experimentId is string
                    && request.resource.data.measurements is map
                    && request.resource.data.review == null
                    && request.resource.data.reviewerId == null
                    && request.resource.data.reviewedAt == null
                    && request.resource.data.reviewNotes == null
                    && request.resource.data.provenance.source == 'community'
                    && experimentExists(request.resource.data.experimentId)
                    && isValidMeasurementPayload(request.resource.data.experimentId, request.resource.data.measurements);

      // An approved result is immutable. Authors may edit only their own
      // unapproved result and cannot alter identity, provenance, or review data.
      allow update: if resource.data.status != 'approved' && (
        (
          (
            (('userId' in resource.data) && isOwner(resource.data.userId)) ||
            (('authorId' in resource.data) && isOwner(resource.data.authorId))
          )
          && resource.data.status in ['pending_review', 'pending', 'draft', 'needs_revision']
          && request.resource.data.status in ['pending_review', 'pending', 'withdrawn', 'needs_revision']
          && request.resource.data.authorId == resource.data.authorId
          && (!('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.experimentId == resource.data.experimentId
          && request.resource.data.type == resource.data.type
          && request.resource.data.provenance == resource.data.provenance
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.review == resource.data.review
          && request.resource.data.reviewerId == resource.data.reviewerId
          && request.resource.data.reviewedAt == resource.data.reviewedAt
          && request.resource.data.reviewNotes == resource.data.reviewNotes
          && isValidMeasurementPayload(request.resource.data.experimentId, request.resource.data.measurements)
        )
        ||
        (
          isModerator()
          && request.resource.data.status in ['approved', 'rejected', 'needs_revision', 'pending_review', 'pending']
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.deviceId == resource.data.deviceId
          && request.resource.data.experimentId == resource.data.experimentId
          && request.resource.data.type == resource.data.type
          && request.resource.data.provenance == resource.data.provenance
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.review.reviewerId == request.auth.uid
          && request.resource.data.reviewerId == request.auth.uid
          && request.resource.data.reviewedAt is string
          && request.resource.data.reviewNotes is string
        )
      );

      allow delete: if resource.data.status != 'approved'
                    && (
                      isAdmin() ||
                      (('authorId' in resource.data) && isOwner(resource.data.authorId)) ||
                      (('userId' in resource.data) && isOwner(resource.data.userId))
                    );
    }

    match /device_stats/{deviceId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Immutable moderation audit records.
    match /admin_audit_logs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator()
                    && request.resource.data.keys().hasAll(['action', 'actorId', 'targetSubmissionId', 'previousStatus', 'newStatus', 'reason', 'timestamp'])
                    && request.resource.data.actorId == request.auth.uid
                    && request.resource.data.action is string
                    && request.resource.data.targetSubmissionId is string
                    && request.resource.data.previousStatus is string
                    && request.resource.data.newStatus is string
                    && request.resource.data.reason is string
                    && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    match /admin_roles/{roleDocId} {
      allow read, write: if isAdmin();
    }

    // 8. Experiment comments
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.authorDisplayName is string
                    && request.resource.data.experimentId is string
                    && request.resource.data.content is string
                    && request.resource.data.content.size() >= 1
                    && request.resource.data.content.size() <= 3000
                    && request.resource.data.createdAt is string
                    && request.resource.data.keys().hasAll(['experimentId', 'authorId', 'authorDisplayName', 'content', 'createdAt']);
      allow update: if isSignedIn() && (
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.experimentId == resource.data.experimentId
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 3000)
        ||
        (request.resource.data.authorId == resource.data.authorId
          && request.resource.data.experimentId == resource.data.experimentId
          && request.resource.data.content == resource.data.content)
      );
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
