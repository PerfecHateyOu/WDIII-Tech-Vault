rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function getUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'contributor';
    }
    function isModerator() {
      return isSignedIn() && (getUserRole() in ['moderator', 'admin', 'owner'] ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com'));
    }
    function isAdmin() {
      return isSignedIn() && (getUserRole() in ['admin', 'owner'] ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com'));
    }
    function isSystemOwner() {
      return isSignedIn() && (getUserRole() == 'owner' ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com'));
    }
    function getExperimentDoc(expId) { return get(/databases/$(database)/documents/experiments/$(expId)).data; }
    function isValidMeasurementPayload(expId, values) {
      return values is map && exists(/databases/$(database)/documents/experiments/$(expId))
        && ('allowedMeasurementKeys' in getExperimentDoc(expId))
        && ('measurementSchema' in getExperimentDoc(expId))
        && getExperimentDoc(expId).measurementSchema is list
        && values.keys().hasOnly(getExperimentDoc(expId).allowedMeasurementKeys);
    }
    function sameIdentity(old, next) {
      return next.authorId == old.authorId && next.userId == old.userId
        && next.experimentId == old.experimentId && next.deviceId == old.deviceId
        && next.type == old.type;
    }
    function protectedReviewFieldsUnchanged(old, next) {
      return next.reviewerId == old.reviewerId && next.reviewedAt == old.reviewedAt
        && next.review == old.review && next.reviewNotes == old.reviewNotes;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && request.resource.data.uid == userId
        && request.resource.data.role == 'contributor'
        && (!('reputationScore' in request.resource.data) || request.resource.data.reputationScore == 0)
        || (isSystemOwner() && request.resource.data.uid == userId && request.resource.data.role == 'owner');
      allow update: if ((isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.reputationScore == resource.data.reputationScore)
        || isAdmin());
      allow delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['id','brand','model','category','origin','status'])
        && request.resource.data.id == deviceId;
      allow delete: if isAdmin();
    }

    match /experiments/{experimentId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['id','title','category','status','origin','measurementSchema','allowedMeasurementKeys'])
        && request.resource.data.id == experimentId
        && request.resource.data.measurementSchema is list
        && request.resource.data.allowedMeasurementKeys is list;
      allow delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if resource.data.status == 'approved' || (isSignedIn() &&
        (resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid || isModerator()));

      // Contributors may only originate a submission in the review queue and may not
      // self-approve by switching a submission directly from pending to approved.
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && (request.resource.data.status == 'pending_review' || request.resource.data.status == 'pending')
        && request.resource.data.type == 'replication'
        && request.resource.data.provenance.source == 'community'
        && request.resource.data.reviewerId == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.review == null
        && request.resource.data.reviewNotes == null
        && request.resource.data.keys().hasAll(['authorId','userId','deviceId','experimentId','type','status','measurements','conditions','evidence','provenance'])
        && isValidMeasurementPayload(request.resource.data.experimentId, request.resource.data.measurements);

      allow update: if resource.data.status != 'approved' && (
        (isOwner(resource.data.authorId)
          && sameIdentity(resource.data, request.resource.data)
          && resource.data.status in ['pending_review','needs_revision','draft']
          && request.resource.data.status in ['pending_review','withdrawn','pending']
          && protectedReviewFieldsUnchanged(resource.data, request.resource.data)
          && isValidMeasurementPayload(request.resource.data.experimentId, request.resource.data.measurements)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','measurements','conditions','notes','evidence','evidenceReferences','updatedAt','submittedAt']))
        || (isModerator()
          && sameIdentity(resource.data, request.resource.data)
          && request.resource.data.status in ['approved','rejected','needs_revision','pending_review','pending']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','reviewerId','reviewedAt','review','reviewNotes']))
      );
      allow delete: if isAdmin() || (isOwner(resource.data.authorId) && resource.data.status != 'approved');
    }

    match /admin_audit_logs/{logId} {
      allow read: if isModerator();
      allow create: if isModerator()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.keys().hasAll(['action','actorId','targetSubmissionId','previousStatus','newStatus','reason','timestamp']);
      allow update, delete: if false;
    }

    match /device_stats/{id} { allow read: if true; allow write: if isModerator(); }
    match /system_config/{configId} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /admin_roles/{id} { allow read, write: if isAdmin(); }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.content is string && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 3000
        && request.resource.data.keys().hasAll(['experimentId', 'authorId', 'authorDisplayName', 'content', 'createdAt']);
      allow update: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());
      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isModerator());
    }
    match /{document=**} { allow read, write: if false; }
  }
}
