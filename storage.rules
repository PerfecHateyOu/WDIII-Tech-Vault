rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Keep this identical to Firestore authorization: trusted custom claims,
    // with the designated owner account as the emergency root credential.
    function moderator() {
      return signedIn() && ((('role' in request.auth.token) && request.auth.token.role in ['moderator','admin','owner']) ||
        (('email' in request.auth.token) && request.auth.token.email.lower() == 'perfectshadowkai33@gmail.com'));
    }
    function evidenceType() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif)') ||
        request.resource.contentType.matches('text/(plain|csv)') ||
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'application/json';
    }
    function evidenceSize() {
      return (request.resource.contentType.matches('image/.*') && request.resource.size <= 8 * 1024 * 1024) ||
        (!request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024);
    }
    match /evidence/{uid}/{fileName} {
      allow read: if owner(uid) || moderator();
      allow create: if owner(uid) && evidenceType() && evidenceSize();
      allow update: if false;
      allow delete: if owner(uid) || moderator();
    }
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow create: if owner(uid) && request.resource.contentType.matches('image/(jpeg|png|webp|gif)') && request.resource.size <= 2 * 1024 * 1024;
      allow update: if owner(uid) && request.resource.contentType.matches('image/(jpeg|png|webp|gif)') && request.resource.size <= 2 * 1024 * 1024;
      allow delete: if owner(uid) || moderator();
    }
    match /official/{allPaths=**} { allow read: if true; allow write: if moderator(); }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
