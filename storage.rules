rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isModerator() {
      return isSignedIn() && (
        ('role' in request.auth.token && (request.auth.token.role in ['moderator', 'admin', 'owner'])) ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'perfectshadowkai33@gmail.com')
      );
    }

    // Personal site: visitors cannot upload anything. Files are added by the owner
    // (Firebase console / gcloud), which bypasses these rules.

    // 1. Evidence and verification media (legacy path, kept readable for the owner)
    match /evidence/{allPaths=**} {
      allow read, delete: if isModerator();
      allow create, update: if false;
    }

    // 2. Official curated platform assets
    match /official/{allPaths=**} {
      allow read: if true;
      allow write: if isModerator();
    }

    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
